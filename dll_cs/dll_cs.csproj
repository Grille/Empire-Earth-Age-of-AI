<!-- The mod's language as a C# project: the language's types (language.cs), the objects a script or text sees (lang/)
     and ageofai.ini's keys (settings/) - for the editor (go to definition, names and types checked) and dotnet build,
     which checks the files compile. Nothing of it runs; its build output goes to local/work/dll_cs
     (Directory.Build.props). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS8981: lower-case type names, the language's and the file's (player, text, display, llm); CS0169 / CS0414 /
         CS0649 / CS8618: fields never used, read, set or initialised - the declarations describe, nothing reads them -->
    <NoWarn>CS8981;CS0169;CS0414;CS0649;CS8618;IDE0380</NoWarn>
  </PropertyGroup>
</Project>
