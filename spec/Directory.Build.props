<!-- spec.csproj's build output (bin, obj) under local/work/spec: nothing of it in the tree. Read before the project, as
     the obj folder has to be known before the SDK is. -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../local/work/spec/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../local/work/spec/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
