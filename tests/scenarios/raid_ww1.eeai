// Continental seed 101, 2 AIs, start epoch 9 (World War I, base ini start_epoch=9): P3 base ~38,38.
// Raiders at P3's citizens: at minute 12 P2 gets 6 doughboys (204), at 16 two Mk V tanks (153), at the edge of P3's
// base; every 20 s they attack the nearest enemy that they can hurt within 30 tiles (stats engage), citizens included.
// The militia question: fight back, or run (tanks are faster than citizens)? Measure P3's workers and losses.

defence(2, 0)
wait_until(12min)
spawn(2, unit.inf10_doughboy, 48, 44, 6)
every(0.33min, 12.20min, 15.83min, (run) => stats("engage", 2, 46, 44, 20))
wait_until(16min)
spawn(2, unit.tank10_mk_v, 50, 46, 2)
every(0.33min, 16.16min, 23.75min, (run) => stats("engage", 2, 46, 44, 20))
