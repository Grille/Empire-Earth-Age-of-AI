// One ship's way across open water (dll/test/fleetmove.c, `fmove trace`): Small Islands (map seed 1, start_epoch 9),
// a dreadnought in the north sea at 52,12 sent to 74,24 (2:1, not a tile direction), then back to 52,12 across, then
// 45 degrees to 66,26: every simulation step its position, heading, speed and script state (# fmtrace) - where it
// stops to turn, how its path zigzags.
wait_until(0.1min)
spawn(1, unit.s10_dreadnought_battleship, 52, 12, 1)
wait_until(0.3min)
cmd("fmove go 1 52 12 2 74 24")
cmd("fmove trace 0")
wait_until(1.5min)
cmd("fmove sum")
cmd("fmove go 1 74 24 3 52 12")
cmd("fmove trace 0")
wait_until(2.7min)
cmd("fmove sum")
cmd("fmove go 1 52 12 3 66 26")
cmd("fmove trace 0")
wait_until(3.7min)
cmd("fmove sum")
