// what triggers' functions set in the script's names (expr.c XI_STOREU: kept in the script's own region, cleared of
// what is dropped): Continental (seed 101) - a timer sets a text, a list and a record every half second, a trigger
// with a condition a text once, an after a list; the script reads them while it waits and at the end.
let n = 0
let last = "none"
let items = [0]
let seen = { tick = 0, name = "" }
let note = "not yet"
let late = [0]
let p = player(2)
let who = p
game.timer(0.5s, () => {
    n += 1
    last = "tick {n} at {game.minutes} min, {p.soldiers} soldiers"
    items = [n, n * 2, n * 3]
    seen = { tick = n, name = last }
    who = game.players[2 + n - 2 * int(n / 2)]
})
trigger({ when = () => n >= 20, run = () => { note = "twenty ticks: {items[2]}, {seen.name}" } })
after(15s, () => { late = [n, items[3]] })
wait_until(0.2min)
ping("at 0.2 min: {n} ticks, {last}, {items[3]}, {seen.tick}, {note}, {who}")
wait_until(0.5min)
ping("at 0.5 min: {n} ticks, {last}, {items[3]}, {seen.tick}, {note}, {late[1]} {late[2]}, {who}")
wait_until(1.2min)
ping("at 1.2 min: {n} ticks, {last}, {items[3]}, {seen.tick}, {seen.name}, {note}, {who}")
