// One ship at the angles between the tile directions (the player: 45 and 90 degrees sail well, the ones between zigzag
// and stop): Small Islands (map seed 1, start_epoch 9), a dreadnought in the open north sea traced every simulation
// step (`fmove trace`, # fmtrace) on five legs: 50,14 -> 71,21 (1:3), -> 53,30 (5:9), -> 67,13 (17:14, about 3:4 the
// other way), -> 49,19 (1:3 back), -> 55,31 (1:2).
wait_until(0.1min)
spawn(1, unit.s10_dreadnought_battleship, 50, 14, 1)
wait_until(0.3min)
cmd("fmove go 1 50 14 2 71 21")
cmd("fmove trace 0")
wait_until(1.4min)
cmd("fmove go 1 71 21 3 53 30")
cmd("fmove trace 0")
wait_until(2.5min)
cmd("fmove go 1 53 30 3 67 13")
cmd("fmove trace 0")
wait_until(3.6min)
cmd("fmove go 1 67 13 3 49 19")
cmd("fmove trace 0")
wait_until(4.7min)
cmd("fmove go 1 49 19 3 55 31")
cmd("fmove trace 0")
wait_until(5.6min)
