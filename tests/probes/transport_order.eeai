// The player's load and unload commands with several transports as a right-click gives them (dll/ai/transports.c,
// transport_split / transport_unload_spread): Small Islands (map seed 1), P1's island - 3 copper transports off its
// south shore, 25 macemen inland; `transports order` selects them (the select command's own step) and executes the
// command's message through the hooks and the game's Execute - at 0.5 min the load onto the transport nearest 26,49,
// at 3 min the unload at 13,61 on the island to the south-west. The circles where each goes are drawn for P1 (this
// PC's player in a test run). [autotest] transport_split=0, transport_unload_spread=0: the game's own commands.
wait_until(0.2min)
spawn(1, unit.s03_copper_transport, 30, 53, 3)
spawn(1, unit.inf03_maceman, 22, 40, 25)
wait_until(0.5min)
cmd("transports order load 1 26 49 10")
wait_until(3min)
cmd("transports id 1")
cmd("transports order unload 1 13 61 25")
wait_until(6min)
cmd("transports id 1")
cmd("objs 1 21")
