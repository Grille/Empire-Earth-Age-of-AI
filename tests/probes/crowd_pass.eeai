// Units passing through a standing crowd (the player: standing units get pressed into each other, flung back once the
// mover is through, or slide in circles round another for a free place): Continental (seed 101, start_epoch 12),
// 40 doughboys gathered at 46,44 by a group move (group_block: a packed block) and settled, then 6 Mark V tanks from 38,48 through them to 54,40, then
// 8 dragoons from 54,40 back through to 38,48. Every unit watched every step (`fmove watch`, # fmwatch).
wait_until(0.1min)
spawn(1, unit.inf10_doughboy, 28, 30, 40)
wait_until(0.15min)
cmd("fmove go 1 34 36 10 46 44")
wait_until(0.9min)
spawn(1, unit.tank10_mk_v, 38, 48, 6)
wait_until(1.0min)
cmd("fmove go 1 38 48 4 54 40")
cmd("fmove add 1 46 44 5")
cmd("fmove watch 1")
wait_until(1.8min)
spawn(1, unit.cav09_dragoon_gun, 56, 38, 8)
wait_until(1.9min)
cmd("fmove go 1 56 38 3 38 48")
cmd("fmove add 1 46 44 5")
wait_until(2.7min)
cmd("fmove sum")
cmd("fmove watch 0")
