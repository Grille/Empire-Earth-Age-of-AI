spawn(1, unit.inf10_doughboy, 42, 40, 1)
spawn(1, unit.inf10_machine_gun, 44, 40, 1)
spawn(1, unit.cav04_war_elephant, 46, 40, 1)
spawn(1, unit.tank10_mk_v, 40, 43, 1)
spawn(1, unit.tank12_m1a1, 43, 43, 1)
