// a script's effects on players (lang/player.cs, game_script/relations.c): Continental (seed 101) - the unit limit set
// (read back: the game's own limit for the player), the map revealed and fogged again (read back), a minimap flare
// (on the map's tiles only: one off the map is a mistake, told; the script goes on in a trigger's way - tested last).
wait_until(0.05min)
let p = player(2)
ping("unit limit {p.unit_limit} (the setting {population_limit}), map revealed {p.map_revealed}")
p.unit_limit = 300
p.map_revealed = true
ping("set: unit limit {p.unit_limit}, map revealed {p.map_revealed}")
p.unit_limit += 20
p.map_revealed = false
ping("then: unit limit {p.unit_limit}, map revealed {p.map_revealed}")
p.flare(vec(40, 40))
player(1).flare(p.units()[1].pos)
ping("flares at 40,40 and at P2's first unit")
