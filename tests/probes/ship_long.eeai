// One ship on long routes (`fmove trace`, # fmtrace): Small Islands (map seed 1, start_epoch 9), a dreadnought from
// the north sea at 60,14 through the channel at x 40-50, y 36-52 to 45,70 (the fleet probe's route), then across the
// southern sea to 75,60 and back west along the islands' coast to 30,60.
wait_until(0.1min)
spawn(1, unit.s10_dreadnought_battleship, 60, 14, 1)
wait_until(0.3min)
cmd("fmove go 1 60 14 2 45 70")
cmd("fmove trace 0")
wait_until(2.6min)
cmd("fmove go 1 45 70 3 75 60")
cmd("fmove trace 0")
wait_until(3.8min)
cmd("fmove go 1 75 60 3 30 60")
cmd("fmove trace 0")
wait_until(5.5min)
