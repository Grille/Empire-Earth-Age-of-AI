// The player's load and unload with a mixed selection (dll/ai/transports.c): Small Islands (map seed 1), P1's island -
// a Chinook and a Pegasus (two helicopter types), a cargo truck and a staff car, a copper transport off the south shore,
// 40 macemen; at 0.5 min `transports order load` clicked on the truck (the nearest 30,46): the click's message names
// the selection's first helicopter and the truck as the unit to load (0x403ADE) - the game failed it; at 3 min the
// unload at 22,48. Late Modern start (start_epoch=12).
wait_until(0.2min)
cmd("spawn 1 376 30 42 1")   // Chinook (the name a_helicopterxprt12_chinook_transport_12 reads as no statement)
cmd("spawn 1 3 32 42 1")     // Pegasus
cmd("spawn 1 215 30 46 1")   // cargo truck
cmd("spawn 1 397 32 46 1")   // staff car
spawn(1, unit.s03_copper_transport, 30, 53, 1)
spawn(1, unit.inf03_maceman, 22, 40, 40)
wait_until(0.5min)
cmd("transports order load 1 30 46 14")
wait_until(3min)
cmd("transports id 1")
cmd("transports order unload 1 22 48 16")
wait_until(5min)
cmd("transports id 1")
