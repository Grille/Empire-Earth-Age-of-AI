// A new order while the ship moves (the player: that is where ships slow down and turn badly): Small Islands (map
// seed 1, start_epoch 9), a dreadnought in the open north sea traced every step (`fmove trace`, # fmtrace). It sails
// 52,12 -> 74,24; under way it is told: 66,26 (nearly ahead), then 52,28 (about 90 degrees off), then 70,14 (behind
// it), then 50,14 again nearly ahead of where it heads - each 15 s after the one before.
wait_until(0.1min)
spawn(1, unit.s10_dreadnought_battleship, 52, 12, 1)
wait_until(0.3min)
cmd("fmove go 1 52 12 2 74 24")
cmd("fmove trace 0")
wait_until(0.55min)
cmd("fmove go 1 60 17 6 66 26")
cmd("fmove trace 0")
wait_until(0.8min)
cmd("fmove go 1 62 20 6 52 28")
cmd("fmove trace 0")
wait_until(1.05min)
cmd("fmove go 1 58 24 6 70 14")
cmd("fmove trace 0")
wait_until(1.3min)
cmd("fmove go 1 60 20 8 50 14")
cmd("fmove trace 0")
wait_until(2.3min)
