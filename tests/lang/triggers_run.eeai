// the triggers' turn (expr.c x_triggers_tick) where a script's own way of using it once broke it: what each line works
// out is in triggers_run.expect - the build runs this through ageofai_check --bench and compares

// an after that makes itself again at 0s: one run a turn (500 ms), not for ever in the same turn
let pumped = 0
pump() {
    pumped += 1
    after(0s, pump)
}
after(0s, pump)
wait(5s)
cmd("after 0s again: {pumped} runs in 5 s")

// a timer's texts with {placeholders}: each keeps its own (a filled text started the turn's region afresh, the next
// text landed on the one before)
let filled = ""
game.timer(1s, () => {
    let xs = [10, 20, 30]
    let a = "first {xs[1]}"
    let b = "second {a} {xs[2]}"
    let s = 0
    for x in xs { s += x }
    filled = "{a} | {b} | {s}"
    return stop
})
wait(2s)
cmd("texts in a timer: {filled}")

// a function over a trigger's kept frame handed to the script and called in its own turn: what it sets there is kept
// (it was the script's region's, freed under the frame when the script's values were cleared - 1 MB of texts here)
nothing() { }
let handed: func<void> = nothing
let seen = ""
let k = 0
start() {
    let msg = "none"
    let set = () => { msg = "set {k} times" }
    trigger({ when: () => true, run: () => {
        handed = set
        seen = msg
    }, loop: true })
}
start()
wait(1s)
let junk = ""
for i in 1..40 {
    k += 1
    handed()
    for j in 1..300 { junk = "{j} {k} padding padding padding padding padding padding padding padding padding padding" }
    wait(0.5s)
}
cmd("the trigger saw: {seen}")
