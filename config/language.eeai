// The words Empire Earth: Age of AI writes on the game's screens, in the game's language ([general] language in
// ageofai.ini, else the game's own). A record per word, en = "..." a must; a language left out shows the English:
// de fr es it pl pt_br ru ko zh_cn zh_tw. The file comes with the mod and every update replaces it.
// {1} {2}: the numbers the mod fills in. {lord}: an expression, as in the personalities' lines.
// Save as UTF-8.

// THE DIPLOMACY SCREEN: a vassal's row
vassal = {
    en = "Vassal",
    de = "Vasall",
}
vassal_of = {
    en = "Vassal of {lord}",
    de = "Vasall von {lord}",
}

