// mod/computer.eeai - eeaimod's base for every personality: no personality itself (it doesn't declare
// register_personality()), a layer of each of them without being named - after their own includes, unless one of
// them names it already (include("mod/computer.eeai")) - and the voice of AIs without any personality.
// Its lines come after a personality's own: when the personality has no line for a situation (nor for the
// situation's fallback: betrayed -> war_declared, ask_lord -> peace_refuse, block_refuse_own -> block_refuse ->
// peace_refuse, surrender -> defeated) that has something to say now, the line comes from here. So it holds what must
// not go unsaid - war, peace, offers that wait for the player's answer, capitulation, victory - and nothing else (an AI
// without a line for a mere comment stays silent). Its names and decide keys count where a personality has none of its
// own. Placeholders as in the personalities: {them} the player the line is about, {me} the AI, {enemy} a third player,
// {tribute} what a capitulation pays or a tribute brought, by resource ("200 gold, 800 iron").
// A pack of your own may bring a base of its own (another name): its personalities include it, this one comes after it.

// the groups of units and buildings to count with (units, army, civilians, buildings ...)
include("mod/units.eeai")

// the war now going on (in peace_accept: the one just ended) - a window for "this war": them.kills(me, this_war, units)
this_war = me.war_minutes(them)
// losses that count as many at this stage of the game: a third of the largest army (10 at least)
many_dead = max(10, max_population / 3)
// tribute that counts as much at this stage of the game: half of what I hold (1500 at least)
big_tribute = max(1500, me.stock / 2)

decide = {
    // What the AI wants in its diplomacy - me is the AI, them the other player, enemy my strongest enemy (there may be
    // none: check it, enemy and ...). Each a number. A personality's own come first; when one fails (a mistake, told in
    // the log) the next layer's decides - these last, and when one of these fails the answer is no.
    // The rules around them stay the mod's: who can be asked, how long an offer stands, no peace within pride x 5 minutes
    // of their declaration of war (pride 60%: 3 minutes).

    // Peace (or an alliance) with them: yes when above 0. How much I like them (opinion -100%..100%), how strong they
    // are against me (at most +-40%: even a much weaker player can buy peace), my temper - and +15% when they fight my
    // strongest enemy too.
    peace_score = (opinion
        + max(-40%, min(40%, 25% * log2(max(1, them.strength) / max(1, me.strength))))
        + 40% * (50% - aggression) - 30% * (pride - 50%)
        + (enemy and enemy != them and them.hostile(enemy) ? 15% : 0)),

    // Look for an ally against my strongest enemy (every minute from minute 10): when it is half again as strong as me.
    seek_ally = enemy and enemy.strength > 1.5 * max(1, me.strength),

    // Which of my strongest enemy's other enemies to ask: the highest score, if above -20%.
    ally_score = opinion,
}

lines = {
    war_declared = [
        them.betrayals(me) > 0 ? [
            "You broke an alliance with us before, {them}. Now you attack. This means war.",
            "Your betrayal is on record, {them}. So is this attack. This means war.",
        ],
        them.tribute(me, 20) > 0 ? [
            "You paid us tribute, {them}. Now you attack us. This means war.",
            "{them.tribute(me, 20)} resources in tribute, and now an attack, {them}. This means war.",
        ],
    ] ?? "You attacked us, {them}. This means war.",
    betrayed = [
        them.betrayals(me) > 0 ? [
            "You have broken an alliance with us again, {them}. This means war.",
            "{them.betrayals(me) + 1} broken alliances with us, {them}. This means war.",
        ],
        me.betrayals(them) > 0 ? [
            "We broke an alliance with you once, {them}. Now you broke ours. This means war.",
            "We betrayed you once, {them}. You have answered in kind. This means war.",
        ],
    ] ?? "You broke our alliance, {them}. This means war.",
    peace_accept = [
        them.betrayals(me) > 0 ? [
            "We accept peace, {them}. Your betrayal is on record.",
            "Peace accepted, {them}. We will watch you: you have broken an alliance with us before.",
        ],
        them.kills(me, this_war, units) > many_dead and them.kills(me, this_war, units) > me.kills(them, this_war, units) and chance(60%) ? "We accept peace, {them}. This war cost us {them.kills(me, this_war, units)} units.",
    ] ?? "We accept peace, {them}.",
    peace_refuse = [
        them.betrayals(me) > 0 ? [
            "We refuse, {them}. You have broken an alliance with us before.",
            "We refuse, {them}. Your word was broken once. We do not take it again.",
        ],
        them.refusals(me, 30) > 0 and chance(70%) ? "We refuse your offer of peace, {them}. You refused ours.",
    ] ?? "We refuse your offer of peace, {them}.",
    // ignored(me): our earlier offers they let run out, in a row
    alliance_offer = [
        them.ignored(me) > 0 ? [
            "{them}, once more: we propose an alliance against {enemy}.",
            "{them}, our last offer went unanswered. We propose an alliance against {enemy} again.",
        ],
    ] ?? "{them}, we propose an alliance against {enemy}.",
    offer_accepted = [
        them.betrayals(me) > 0 ? [
            "Our alliance stands, {them}. Your earlier betrayal is on record.",
            "Our alliance stands, {them}. Do not break this one.",
        ],
    ] ?? "Our alliance stands, {them}.",
    offer_withdrawn = them.ignored(me) > 0 ? [
        "No answer again, {them}. Our offer is withdrawn.",
        "{them.ignored(me) + 1} offers without an answer, {them}. This one is withdrawn as well.",
    ] : [
        "No answer, {them}. Our offer is withdrawn.",
        "Our offer has expired, {them}. You did not answer.",
    ],
    betray = [
        them.betrayals(me) > 0 ? [
            "Our alliance is over, {them}. You broke one with us first.",
            "We end our alliance, {them}. You did the same to us before.",
        ],
    ] ?? "Our alliance is over, {them}.",
    tribute_thanks = [
        at_war ? [
            "Tribute received, {them}: {tribute}. We are still at war.",
            "Your tribute is noted, {them}. It does not end the war.",
        ],
        them.tribute(me) > big_tribute and chance(50%) ? "Tribute received: {tribute}. {them.tribute(me) + tribute_total} resources from you so far, {them}. Thank you.",
    ] ?? "Tribute received: {tribute}. Thank you, {them}.",
    capitulate = "{them}, we surrender. We offer {tribute} for peace.",
    capitulate_accepted = "{tribute} paid. We will stand by you, {them}.",
    capitulate_refused = "No answer, {them}. Then we fight on.",
    block_refuse = "We refuse, {them}: no peace while {enemy} is your ally.",
    block_refuse_own = "We refuse, {them}: our ally {enemy} will not make peace with you.",
    ask_lord = "We are a vassal of {enemy}, {them}. Negotiate with them.",
    vassal_grumble = "As you command, {them}. Peace with {enemy}.",
    all_submitted = "Every player has submitted to you, {them}.",
    other_victory = lord == them ? [
        "Victory to our lord, {them}.",
        "Our lord has won, {them}. We served to the end.",
    ] : [
        "Victory to our alliance, {them}.",
        "The war is won, {them}. Our alliance held.",
    ],
    surrender = "We give up.",
    defeated = "We have been defeated.",
}
