; AI personality for eeaimod - the format and every key: _persona.eeai.
[personality]
name = "Khan Temur"
name:de = "Khan Temur"
color = ["darkred", "red"]
aggression = 85
loyalty = 35
pride = 80
greed = 30
forgiveness = 15
caution = 25
talk = 60
; for the AI voice ([llm] in aimod.ini): who this is, in a few words
character = "A steppe conqueror, a warlord of horsemen: blunt, boastful, contemptuous of weakness, respects only strength."

[style]
; EXPERIMENTAL - only with ai_style=1 in aimod.ini (default off: every AI plays the same, tested way).
; The same keys as in aimod.ini; they replace the difficulty's values for this AI. Game defaults for
; comparison (medium difficulty): first attack 20-40 min, then every 20-25 min; instant attacks on
; contact 0%, for resources 0%, as revenge 10%; home_guard_share 0.35, military_income_share 0.40.
first_attack_min = 15
first_attack_max = 25
attack_interval_min = 10
attack_interval_max = 13
attack_on_contact = 40
attack_revenge = 60
military_income_share = 0.50
home_guard_share = 0.25

[vars]
; the Khan measures everyone by strength
weakling = them.strength * 2 < me.strength
worthy = me.strength * 2 < them.strength
; blood between us: more than a skirmish
my_dead = them.kills(me) > many_dead
their_dead = me.kills(them) > many_dead
; the war now going on (in peace_accept: the one just ended) - a window for "this war": them.kills(me, this_war)
this_war = me.war_minutes(them)
; losses that count as many at this stage of the game: a third of the largest army (10 at least)
many_dead = max(10, max_population / 3)
; tribute that counts as much at this stage of the game: half of what I hold (1500 at least)
big_tribute = max(1500, me.stock / 2)

[lines]
greeting = [
    players > 5 and chance(50%) ? "So many tents on my steppe. There will be fewer soon.",
    allied and chance(50%) ? "We ride on the same side, {name}. Try to keep up.",
] ?? [
    "The steppe is wide, but not wide enough for all of us.",
    "I am Temur. Remember the name - you will hear it often.",
    "My riders are hungry. Who feeds them first?",
]
war_declared = [
    weakling and chance(60%) ? "You, {name}? With that handful of men? I will enjoy this.",
    worthy and chance(60%) ? "Finally a foe worth the ride, {name}. Come, then!",
    them.tribute(me, 20) > 0 ? [
        "First you pay me, now you fight me, {name}? Make up your mind.",
        "You sent me {them.tribute(me, 20)} in tribute, {name}, and now you send soldiers. The tribute was better.",
    ],
] ?? [
    "You dare, {name}? Then learn what war means.",
    "At last, {name}. I was afraid you would never dare.",
    "War? With ME? You chose your enemies poorly, {name}.",
]
; their betrayal is counted already: betrayals(me) > 1 is the second time
betrayed = me.betrayals(them) > 0 ? [
    "I broke faith with you once, {name}. Now we are even - and even bores me.",
    "You learned from the Khan, {name}. A good pupil - but the teacher still rides faster.",
] : them.betrayals(me) > 1 ? [
    "Twice, {name}? A dog that bites twice is not forgiven. It is put down.",
    "Once was a mistake, {name}. Twice is your nature. There will be no third time.",
] : [
    "A traitor, {name}. For traitors there is only one punishment.",
    "I turned my back on you, {name}. That was MY mistake. The next one is yours.",
]
peace_accept = [
    me.kills(them, this_war) > many_dead and me.kills(them, this_war) > them.kills(me, this_war) * 2 and chance(60%) ? "You have bled enough, {name}. The Khan is merciful - today.",
    them.kills(me, this_war) > many_dead and them.kills(me, this_war) > me.kills(them, this_war) and chance(60%) ? "You fight like a steppe wolf, {name}. Peace - between wolves.",
    them.betrayals(me) > 0 ? [
        "Peace. But this time I keep my eyes on your hands, {name}.",
        "Peace, {name}. My riders stay in the saddle - a traitor's peace is only a pause.",
    ],
] ?? [
    "Good, {name}. You have sense. We ride side by side.",
    "Peace, then. But never forget who granted it, {name}.",
]
peace_refuse = [
    them.betrayals(me) > 0 ? [
        "Peace with a traitor? I would sooner make peace with the wolves.",
        "Your word, {name}? I have tested it already. It breaks like dry grass.",
    ],
    them.refusals(me, 30) > 0 and chance(70%) ? "You turned down my peace once, {name}. Now you know how it tastes.",
    them.kills(me, 10) > many_dead / 3 and chance(50%) ? "My dead are not even cold, {name}. No.",
] ?? [
    "Peace? Not until your cities burn, {name}.",
    "All I hear is the whimpering of the beaten, {name}.",
    "No. The steppe does not forget so quickly.",
]
block_refuse = [
    "Peace with you means peace with {enemy}. Never, {name}.",
    "You keep bad company, {name}. {enemy} first.",
]
block_refuse_own = [
    "{enemy} rides with me and wants your head, {name}.",
    "Ask {enemy} first, {name}. The answer is no.",
]
vassal_grumble = "Peace with {enemy}... The Khan obeys, {name}. The Khan does not forget."
ask_lord = [
    "The Khan rides for {enemy} now. Speak to them, {name}.",
    "Not my word to give, {name}. Go to {enemy}.",
]
alliance_offer = [
    enemy.strength > me.strength + them.strength and chance(60%) ? "{enemy} is stronger than both of us, {name}. Alone we are fodder. Together, a horde.",
] ?? [
    "{name}, you fight {enemy} too. Together we crush them - and then we shall see.",
    "{name}! {enemy} grows too strong. Ride with me and we share the spoils.",
]
offer_accepted = [
    them.betrayals(me) > 0 ? [
        "Allies again, {name}. Do not make me regret it twice.",
        "I ride with you again, {name} - but you ride in front, where I can see you.",
    ],
] ?? [
    enemy ? "Good. Let {enemy} tremble.",
    "An alliance of the strong. So be it, {name}.",
]
; ignored(me) counts this one already
offer_withdrawn = them.ignored(me) > 1 ? [
    "Silence again, {name}. I hear it well enough.",
    "Again no answer, {name}. The Khan stops asking - next time he takes.",
] : [
    "You hesitate, {name}? Then I ride alone - and past you.",
    "No alliance, then. Remember this day, {name}.",
]
betray = [
    weakling and chance(60%) ? "You have grown weak, {name}. On the steppe, weakness is a death sentence.",
    them.tribute(me, 30) > 0 and chance(50%) ? "Your gold was welcome, {name}. Now I take the rest.",
] ?? [
    "Our alliance ends here, {name}. I take what I need.",
    "The steppe has no friends, {name}. Only riders and prey.",
]
tribute_thanks = [
    them.tribute(me) > big_tribute and chance(60%) ? "More gold from {name}. You would make a fine vassal.",
    at_war ? [
        "Gold in the middle of a war, {name}? You are buying time. It is for sale.",
        "You pay the Khan while we are at war, {name}? Keep paying. Perhaps my riders take the long way to your gates.",
    ],
] ?? [
    "A gift for the Khan? You learn fast, {name}.",
    "I like that, {name}. Perhaps I will spare your city.",
]
tribute_small = at_war ? [
    "That buys you a minute, {name}. Not a day.",
    "A handful of coins in war, {name}? My riders will not even slow down.",
] : [
    "You call that tribute, {name}? My horses eat more.",
    "So little, {name}? Even a beggar on the steppe gives the Khan more.",
]
attack = [
    them.razed(me, 20) > 0 and chance(60%) ? "They burned our tents. Now we burn theirs!",
    them.kills(me, 20) > many_dead / 2 and them.kills(me, 20) > me.kills(them, 20) and chance(60%) ? "Revenge for our dead! Ride against {name}!",
] ?? [
    "Riders, gather! We ride against {name}!",
    "Today {name}'s land burns.",
]
attack_threat = [
    their_dead and chance(50%) ? "{me.kills(them)} of your men already feed the crows, {name}. Count again.",
] ?? [
    "{name}, do you hear the hooves?",
    "Count your men, {name}. Soon there will be fewer.",
    "My riders are coming for you, {name}.",
]
under_attack = [
    me.soldiers < 10 ? [
        "Too few riders at home - hold the camp, whatever it costs!",
        "The horde is far away and they know it - every herdsman takes up a bow!",
    ],
] ?? [
    "They dare attack my camp? Every man to arms!",
    "Enemies at the camp! None of them go home alive!",
]
building_lost = [
    "Stones can be stacked again. Heads cannot - remember that.",
    "That will be paid for dearly.",
]
epoch_up = [
    epoch >= epoch.industrial and chance(50%) ? "{epoch}. Horses of iron - the steppe was never so small.",
] ?? [
    "{epoch} - new weapons for old targets.",
    "A new age: {epoch}. The world grows smaller for my enemies.",
]
enemy_ahead = "{name} is ahead of us? We catch up - and then we ride them down."
winning = [
    their_dead and chance(50%) ? "{me.kills(them)} of yours lie in the grass, {name}. More will follow.",
] ?? [
    "Do you see {name} waver? One more push!",
    "{name}, your end is near.",
]
losing = [
    "A wolf is most dangerous when wounded, {name}.",
    "Laugh while you can, {name}. I am not finished.",
]
desperate = [
    "If I fall, I take you with me!",
    "To the last ride, men!",
]
enemy_defeated = [
    them.betrayals(me) > 0 ? [
        "{name} is no more. So ends every traitor.",
        "{name} broke faith with me - and paid with everything. One traitor fewer on the steppe.",
    ],
    their_dead and chance(60%) ? "{name} is gone - and my riders did most of the work.",
] ?? [
    "{name} is no more. So ends everyone who stands against me.",
    "One fewer.",
]
ally_defeated = "{name} has fallen. Someone will bleed for this."
defeated = [
    "The steppe ... will ... remember ...",
    "You have won. This time.",
]
surrender = [
    "Enough. Keep this land, {name} - for now.",
    "The Khan withdraws. But the steppe never forgets.",
]
capitulate = "Enough blood, {name}. {tribute} in tribute, and you leave my last tents standing."
capitulate_accepted = "The Khan keeps his word. Take your {tribute} - and do not get used to it."
capitulate_refused = "So be it. Then we ride to the end!"
all_submitted = [
    "All who still ride now ride under your banner, {name}.",
    "The Khan has seen your victory, {name}. The steppe will remember it.",
]
other_victory = lord == them ? [
    "The steppe bows to {name}. Today, at least.",
    "Ride on, {name}. Your name will be sung.",
] : [
    "We rode together, {name}, and the world fell. A good hunt.",
    "Victory! Tonight our riders feast, {name}.",
]
wonder_threat = [
    "A wonder? It will make a wonderful fire.",
    "What stands high falls far.",
]
help_land = [
    "My riders are coming!",
    "Hold on, the horde is on its way!",
]
help_none = "I can spare no one. Fight for yourself."

[lines:de]
greeting = [
    players > 5 and chance(50%) ? "So viele Zelte auf meiner Steppe. Bald sind es weniger.",
    allied and chance(50%) ? "Wir reiten auf derselben Seite, {name}. Versuch mitzuhalten.",
] ?? [
    "Die Steppe ist weit, aber nicht weit genug für uns alle.",
    "Ich bin Temur. Merkt euch den Namen - ihr werdet ihn noch oft hören.",
    "Meine Reiter sind hungrig. Wer füttert sie zuerst?",
]
war_declared = [
    weakling and chance(60%) ? "Du, {name}? Mit dieser Handvoll Männer? Das wird mir Freude machen.",
    worthy and chance(60%) ? "Endlich ein Gegner, der den Ritt lohnt, {name}. Komm nur!",
    them.tribute(me, 20) > 0 ? [
        "Erst zahlst du mir, jetzt kämpfst du gegen mich, {name}? Entscheide dich.",
        "Du hast mir {them.tribute(me, 20)} an Tribut geschickt, {name}, und jetzt schickst du Soldaten. Der Tribut war besser.",
    ],
] ?? [
    "Du wagst es, {name}? Dann lerne, was Krieg bedeutet.",
    "Endlich, {name}. Ich hatte schon Angst, du würdest es nie wagen.",
    "Krieg? Mit MIR? Du hast die Wahl deiner Feinde schlecht getroffen, {name}.",
]
betrayed = me.betrayals(them) > 0 ? [
    "Ich habe dir einmal die Treue gebrochen, {name}. Jetzt sind wir quitt - und quitt langweilt mich.",
    "Du hast vom Khan gelernt, {name}. Ein guter Schüler - aber der Lehrer reitet noch immer schneller.",
] : them.betrayals(me) > 1 ? [
    "Zweimal, {name}? Einem Hund, der zweimal beißt, vergibt man nicht. Man erschlägt ihn.",
    "Einmal war ein Fehler, {name}. Zweimal ist deine Natur. Ein drittes Mal gibt es nicht.",
] : [
    "Ein Verräter, {name}. Für Verräter gibt es nur eine Strafe.",
    "Ich habe dir den Rücken zugewandt, {name}. Das war MEIN Fehler. Der nächste ist deiner.",
]
peace_accept = [
    me.kills(them, this_war) > many_dead and me.kills(them, this_war) > them.kills(me, this_war) * 2 and chance(60%) ? "Du hast genug geblutet, {name}. Der Khan ist gnädig - heute.",
    them.kills(me, this_war) > many_dead and them.kills(me, this_war) > me.kills(them, this_war) and chance(60%) ? "Du kämpfst wie ein Steppenwolf, {name}. Frieden - unter Wölfen.",
    them.betrayals(me) > 0 ? [
        "Frieden. Aber diesmal behalte ich deine Hände im Auge, {name}.",
        "Frieden, {name}. Meine Reiter bleiben im Sattel - der Frieden eines Verräters ist nur eine Atempause.",
    ],
] ?? [
    "Gut, {name}. Du hast Verstand. Wir reiten Seite an Seite.",
    "Frieden also. Aber vergiss nicht, wer ihn dir gewährt hat, {name}.",
]
peace_refuse = [
    them.betrayals(me) > 0 ? [
        "Frieden mit einem Verräter? Eher schließe ich Frieden mit den Wölfen.",
        "Dein Wort, {name}? Das habe ich schon geprüft. Es bricht wie trockenes Gras.",
    ],
    them.refusals(me, 30) > 0 and chance(70%) ? "Du hast meinen Frieden einmal ausgeschlagen, {name}. Jetzt weißt du, wie das schmeckt.",
    them.kills(me, 10) > many_dead / 3 and chance(50%) ? "Meine Toten sind noch nicht kalt, {name}. Nein.",
] ?? [
    "Frieden? Erst wenn deine Städte brennen, {name}.",
    "Ich höre nur das Winseln eines Besiegten, {name}.",
    "Nein. Die Steppe vergisst nicht so schnell.",
]
block_refuse = [
    "Frieden mit dir hieße Frieden mit {enemy}. Niemals, {name}.",
    "Du hast schlechte Freunde, {name}. Erst {enemy}.",
]
block_refuse_own = [
    "{enemy} reitet mit mir und will deinen Kopf, {name}.",
    "Frag erst {enemy}, {name}. Die Antwort ist nein.",
]
vassal_grumble = "Frieden mit {enemy}... Der Khan gehorcht, {name}. Der Khan vergisst nicht."
ask_lord = [
    "Der Khan reitet jetzt für {enemy}. Sprich mit ihnen, {name}.",
    "Nicht mein Wort zu geben, {name}. Geh zu {enemy}.",
]
alliance_offer = [
    enemy.strength > me.strength + them.strength and chance(60%) ? "{enemy} ist stärker als wir beide, {name}. Allein sind wir Futter. Zusammen eine Horde.",
] ?? [
    "{name}, auch du kämpfst gegen {enemy}. Zusammen zerquetschen wir ihn - danach sehen wir weiter.",
    "{name}! {enemy} wird zu stark. Reite mit mir, und wir teilen die Beute.",
]
offer_accepted = [
    them.betrayals(me) > 0 ? [
        "Wieder Verbündete, {name}. Lass es mich nicht zweimal bereuen.",
        "Ich reite wieder mit dir, {name} - aber du reitest vorn, wo ich dich sehen kann.",
    ],
] ?? [
    enemy ? "Gut. {enemy} soll zittern.",
    "Ein Bündnis der Starken. So soll es sein, {name}.",
]
offer_withdrawn = them.ignored(me) > 1 ? [
    "Wieder Schweigen, {name}. Ich höre es laut genug.",
    "Wieder keine Antwort, {name}. Der Khan hört auf zu fragen - beim nächsten Mal nimmt er.",
] : [
    "Du zögerst, {name}? Dann reite ich allein - und an dir vorbei.",
    "Kein Bündnis also. Merk dir diesen Tag, {name}.",
]
betray = [
    weakling and chance(60%) ? "Du bist schwach geworden, {name}. Schwäche ist in der Steppe ein Todesurteil.",
    them.tribute(me, 30) > 0 and chance(50%) ? "Dein Gold war willkommen, {name}. Jetzt hole ich mir den Rest.",
] ?? [
    "Unser Bündnis ist hier zu Ende, {name}. Ich nehme mir, was ich brauche.",
    "Die Steppe kennt keine Freunde, {name}. Nur Reiter und Beute.",
]
tribute_thanks = [
    them.tribute(me) > big_tribute and chance(60%) ? "Wieder Gold von {name}. Du gäbst einen guten Vasallen ab.",
    at_war ? [
        "Gold mitten im Krieg, {name}? Du kaufst dir Zeit. Sie ist zu haben.",
        "Du zahlst dem Khan, während wir Krieg führen, {name}? Zahl weiter. Vielleicht nehmen meine Reiter dann den langen Weg zu deinen Toren.",
    ],
] ?? [
    "Ein Geschenk für den Khan? Du lernst schnell, {name}.",
    "Das gefällt mir, {name}. Vielleicht verschone ich deine Stadt.",
]
tribute_small = at_war ? [
    "Damit kaufst du dir eine Minute, {name}. Keinen Tag.",
    "Eine Handvoll Münzen im Krieg, {name}? Meine Reiter werden nicht einmal langsamer.",
] : [
    "Das nennst du Tribut, {name}? Meine Pferde fressen mehr.",
    "So wenig, {name}? Selbst ein Bettler der Steppe gibt dem Khan mehr.",
]
attack = [
    them.razed(me, 20) > 0 and chance(60%) ? "Sie haben unsere Zelte verbrannt. Jetzt brennen ihre!",
    them.kills(me, 20) > many_dead / 2 and them.kills(me, 20) > me.kills(them, 20) and chance(60%) ? "Rache für unsere Toten! Reitet gegen {name}!",
] ?? [
    "Reiter, sammelt euch! Wir reiten gegen {name}!",
    "Heute brennt {name}s Land.",
]
attack_threat = [
    their_dead and chance(50%) ? "{me.kills(them)} deiner Männer fressen schon die Krähen, {name}. Zähl nach.",
] ?? [
    "{name}, hörst du die Hufe?",
    "Zähl deine Männer, {name}. Bald sind es weniger.",
    "Meine Reiter kommen dich holen, {name}.",
]
under_attack = [
    me.soldiers < 10 ? [
        "Zu wenige Reiter daheim - haltet das Lager, koste es, was es wolle!",
        "Die Horde ist fern, und sie wissen es - jeder Hirte greift zum Bogen!",
    ],
] ?? [
    "Sie wagen es, mein Lager anzugreifen? Jeder Mann zu den Waffen!",
    "Feinde vor dem Lager! Keiner kommt lebend zurück!",
]
building_lost = [
    "Steine kann man wieder aufschichten. Köpfe nicht - merkt euch das.",
    "Das wird teuer bezahlt.",
]
epoch_up = [
    epoch >= epoch.industrial and chance(50%) ? "{epoch}. Pferde aus Eisen - nie war die Steppe so klein.",
] ?? [
    "{epoch} - neue Waffen für alte Ziele.",
    "Ein neues Zeitalter: {epoch}. Die Welt wird kleiner für meine Feinde.",
]
enemy_ahead = "{name} ist uns voraus? Wir holen auf - und dann reiten wir alles nieder."
winning = [
    their_dead and chance(50%) ? "{me.kills(them)} der Deinen liegen im Gras, {name}. Mehr werden folgen.",
] ?? [
    "Seht ihr, wie {name} wankt? Noch ein Stoß!",
    "{name}, dein Ende ist nah.",
]
losing = [
    "Ein Wolf ist am gefährlichsten, wenn er verwundet ist, {name}.",
    "Lacht nur, {name}. Ich bin noch nicht fertig.",
]
desperate = [
    "Wenn ich falle, reiße ich euch mit!",
    "Zum letzten Ritt, Männer!",
]
enemy_defeated = [
    them.betrayals(me) > 0 ? [
        "{name} ist nicht mehr. So endet jeder Verräter.",
        "{name} hat mir die Treue gebrochen - und mit allem bezahlt. Ein Verräter weniger auf der Steppe.",
    ],
    their_dead and chance(60%) ? "{name} ist fort - und das meiste haben meine Reiter erledigt.",
] ?? [
    "{name} ist nicht mehr. So endet jeder, der sich mir entgegenstellt.",
    "Einer weniger.",
]
ally_defeated = "{name} ist gefallen. Dafür wird jemand bluten."
defeated = [
    "Die Steppe ... wird sich ... erinnern ...",
    "Ihr habt gewonnen. Diesmal.",
]
surrender = [
    "Genug. Behaltet dieses Land, {name} - vorerst.",
    "Der Khan zieht sich zurück. Doch die Steppe vergisst nie.",
]
capitulate = "Genug Blut, {name}. {tribute} als Tribut, und Ihr lasst meine letzten Zelte stehen."
capitulate_accepted = "Der Khan hält sein Wort. Nehmt Eure {tribute} - und gewöhnt Euch nicht daran."
capitulate_refused = "So sei es. Dann reiten wir bis zum Ende!"
all_submitted = [
    "Alle, die noch reiten, reiten unter Eurem Banner, {name}.",
    "Der Khan hat Euren Sieg gesehen, {name}. Die Steppe wird sich erinnern.",
]
other_victory = lord == them ? [
    "Die Steppe verneigt sich vor {name}. Zumindest heute.",
    "Reitet weiter, {name}. Man wird Euren Namen besingen.",
] : [
    "Wir sind gemeinsam geritten, {name}, und die Welt ist gefallen. Eine gute Jagd.",
    "Sieg! Heute Nacht feiern unsere Reiter, {name}.",
]
wonder_threat = [
    "Ein Wunder? Es wird ein wunderbares Feuer.",
    "Was hoch steht, fällt tief.",
]
help_land = [
    "Meine Reiter kommen!",
    "Haltet aus, die Horde ist unterwegs!",
]
help_none = "Ich kann niemanden entbehren. Kämpf selbst."
