; AI personality for eeaimod - the format and every key: _persona.eeai.
include = "_eeaimod_shared.eeai"
[personality]
name = "Princess Livia"
name:de = "Fürstin Livia"
civilization = "Silver Court"
civilization:de = "Silberner Hof"
color = ["magenta", "purple"]
aggression = 60%
loyalty = 15%
pride = 40%
greed = 60%
forgiveness = 50%
caution = 45%
talk = 55%
; for the AI voice ([llm] in aimod.ini): who this is, in a few words
character = "A scheming princess, charming and polite on the surface, cold and calculating beneath; enjoys hints and veiled threats."

[style]
; EXPERIMENTAL - only with ai_style=1 in aimod.ini (default off: every AI plays the same, tested way).
; The same keys as in aimod.ini; they replace the difficulty's values for this AI. Game defaults for
; comparison (medium difficulty): first attack 20-40 min, then every 20-25 min; instant attacks on
; contact 0%, for resources 0%, as revenge 10%; home_guard_share 0.35, military_income_share 0.40.
first_attack_min = 18
first_attack_max = 30
attack_on_contact = 20
attack_for_resources = 25
attack_revenge = 30

[vars]
; Livia weighs everyone by their use to her: a pawn to be moved, a rival to be handled with care
pawn = them.strength * 2 < me.strength
rival = me.strength * 2 < them.strength
; blood between us: more than a skirmish
my_dead = them.kills(me) > many_dead
their_dead = me.kills(them) > many_dead

[lines]
greeting = [
    players == 2 and chance(50%) ? "Just the two of us? How intimate.",
    players > 5 and chance(50%) ? "So many guests. I do hope there are enough chairs ... for a while.",
    allied and chance(50%) ? "Allies already, {them}? How sweet. Let us see how long it lasts.",
] ?? [
    players > 2 ? "How lovely to meet you all.",
    "I am sure we will ... get along splendidly.",
    "Friends? Enemies? Oh, that will sort itself out.",
]
war_declared = [
    them.tribute(me, 20) > 0 ? [
        "First gifts, now war? How fickle you are, {them}.",
        "Thank you for the gifts, {them}. They will make such lovely arrows - pointed at you.",
    ],
    them.refusals(me) > 0 and chance(60%) ? "First you refuse my hand, {them}, now you raise your fist. You make it so easy to dislike you.",
    pawn and chance(60%) ? "You, {them}? With so little? How brave. How very foolish.",
    rival and chance(60%) ? "War, {them}? Then I shall simply have to be cleverer than you are strong. That should not be difficult.",
] ?? [
    "How clumsy of you, {them}.",
    "War, {them}? I had hoped you were cleverer.",
    "Oh, {them}. You should not have done that.",
]
; their betrayal is counted already: betrayals(me) > 1 is the second time
betrayed = me.betrayals(them) > 0 ? [
    "Returning the favour, {them}? I suppose I taught you that. How flattering.",
    "A knife for a knife, {them}? How very fair of you. I had no idea you kept accounts.",
] : them.betrayals(me) > 1 ? [
    "Twice, {them}? Once is a surprise. Twice is a habit - and habits can be broken. Like so many other things.",
    "Again, {them}? I made a little note the first time. Now I shall have to start a whole book.",
] : [
    "You of all people, {them}? I am almost impressed.",
    "Betrayal is my art, {them}. You are a mere dabbler.",
]
peace_accept = [
    them.betrayals(me) > 0 ? [
        "Peace, {them}. I forgive - I simply never forget.",
        "Peace, {them}. And this time I shall keep my back to the wall, if you don't mind.",
    ],
    them.kills(me, this_war) > many_dead and them.kills(me, this_war) > me.kills(them, this_war) and chance(60%) ? "You have made your point, {them}. Rather emphatically. Peace.",
    them.tribute(me, 30) > 0 and chance(50%) ? "Your gifts did not go unnoticed, {them}. I am always kind to generous people.",
] ?? [
    "Peace, {them}? Gladly. For now.",
    "As you wish, {them}. We are friends now.",
]
peace_refuse = [
    them.betrayals(me) > 0 ? [
        "Peace with you, {them}? I trusted you once. Once is my limit.",
        "Your word, {them}? I already have one of those. It broke the first time I leaned on it.",
    ],
    them.refusals(me) > 0 and chance(70%) ? "Now you want peace? I offered you my hand, {them}, and you slapped it away. I remember these things.",
    them.ignored(me) > 0 and chance(60%) ? "You let my offer gather dust, {them}. Now yours can do the same.",
    them.opinion(me) < -50% and chance(50%) ? "You cannot stand me, {them}, and now you want peace? How ... suspicious.",
] ?? [
    "Why should I, {them}? What is in it for me?",
    "Later perhaps, {them}. It does not suit me now.",
    "Convince me, {them}. With gold, perhaps?",
]
block_refuse = [
    enemy.betrayals(me) > 0 ? [
        "{enemy} at your table, {them}? {enemy} once put a knife in my back. I do not dine with knives.",
        "Do ask {enemy} what became of their last alliance with me, {them}. Then ask yourself why I decline.",
    ],
] ?? [
    "An alliance with {enemy} in it? I am not that foolish, {them}.",
    "{enemy} at your table, {them}? Then I dine elsewhere.",
]
block_refuse_own = [
    "And upset {enemy}? My ally would never forgive me, {them}.",
    "{enemy} would be most displeased, {them}. Another time.",
]
vassal_grumble = [
    enemy.betrayals(me) > 0 ? [
        "Peace with {enemy}, who betrayed me? As you command, {them}. I shall smile at them. Very sweetly.",
        "{enemy} broke faith with me, and now I must call them friend? Your wish, {them}. Peace has such short memories - mine is long.",
    ],
] ?? "Peace with {enemy}? If you insist, {them}. I shall keep an eye on them."
ask_lord = [
    "Oh, I would love to, {them}. But {enemy} holds my leash now.",
    "Ask {enemy}, {them}. I am merely the humble servant.",
]
alliance_offer = [
    enemy.betrayals(them) > 0 ? [
        "{enemy} betrayed you once, {them}. I would never ... well. Shall we teach them some manners together?",
        "Does it still sting, {them}, what {enemy} did to you? Revenge is so much sweeter shared.",
    ],
    enemy.strength > me.strength + them.strength and chance(60%) ? "{enemy} is stronger than the two of us together, {them}. Alone we are dessert. Together we might be the cook.",
    them.refusals(me) > 0 and chance(60%) ? "I know, {them}, you turned me down before. But {enemy} changes things, doesn't it?",
    them.opinion(me) > 30% and chance(60%) ? "You have always thought so well of me, {them}. Let us make it official - against {enemy}.",
] ?? [
    "{them}, darling, {enemy} will devour us both. Shouldn't we ... work together?",
    "A proposal, {them}: the two of us against {enemy}. What do you say?",
]
offer_accepted = [
    them.betrayals(me) > 0 ? [
        "Friends again, {them}. I shall keep a chair for you - and a dagger under it. Just in case.",
        "Allies once more, {them}. Last time you ended it. This time, I think, I shall.",
    ],
    them.refusals(me) > 0 and chance(60%) ? "You said no before, {them}. I knew you would come round.",
] ?? [
    enemy ? "Wonderful, {them}. {enemy} will not like this at all.",
    "How nice, we understand each other.",
]
; ignored(me) counts this one already
offer_withdrawn = them.ignored(me) > 1 ? [
    "Ignored again, {them}? I keep a little list, you know. You are on it {them.ignored(me)} times now.",
    "{them.ignored(me)} offers, {them}, and not one answer. Silence is an answer too, you know. I heard it.",
] : [
    "You hesitated too long, {them}. Such a pity.",
    "Never mind, {them}. I will remember this.",
]
betray = [
    them.betrayals(me) > 0 ? [
        "You taught me this game yourself, {them}. Do you like my progress?",
        "Did you think I had forgotten, {them}? I was only waiting for the right moment. This is it.",
    ],
    them.tribute(me, 30) > 0 and chance(50%) ? "Thank you for all the gifts, {them}. They will pay for the war.",
    pawn and chance(60%) ? "You have become such a burden, {them}. A lady must travel light.",
] ?? [
    "I am so sorry, {them}. No, not really.",
    "You were useful, {them}. Now you are not.",
    "Did you really think I was your friend, {them}?",
]
tribute_thanks = [
    at_war ? [
        "Gold in the middle of a war, {them}? How touching. It changes nothing - well, almost nothing.",
        "Paying your enemy, {them}? I shall spend it carefully. On soldiers, most likely.",
    ],
    them.betrayals(me) > 0 and chance(60%) ? "Gifts from a traitor, {them}? Guilt suits you.",
    them.tribute(me) > big_tribute and chance(60%) ? "{them.tribute(me)} in gifts already, {them}. One could almost think you were afraid of me.",
] ?? [
    "For me? How thoughtful, {them}.",
    "You know how to treat a lady, {them}.",
]
tribute_small = at_war ? [
    "A trinket in the middle of a war, {them}? You do value yourself cheaply.",
    "Is that the price of peace in your eyes, {them}? Then the war goes on.",
] : [
    "Is that all, {them}?",
    "How ... modest, {them}. I shall find a small drawer for it.",
]
attack = [
    them.razed(me, 20) > 0 and chance(60%) ? "{them} broke some of my lovely things. Let us return the courtesy.",
    them.betrayals(me) > 0 and chance(60%) ? "{them} once broke faith with me. Today the bill arrives.",
    them.refusals(me) > 1 and chance(50%) ? "{them} has said no to me so often. Let us see if they can say no to this.",
] ?? [
    "Time for a little surprise for {them}.",
    "Our troops are on their way to {them}. Quietly.",
]
attack_threat = [
    them.betrayals(me) > 0 and chance(60%) ? "Do you sleep well, {them}? Traitors usually don't.",
    them.refusals(me) > 0 and chance(50%) ? "You should have accepted my offer, {them}. Do you remember it? I do.",
    their_dead and chance(50%) ? "{me.kills(them)} of your people already, {them}. I could stop counting - but I so enjoy it.",
] ?? [
    "Let us see how well you sleep, {them}.",
    "A little surprise is on its way to you, {them}.",
    "{them}, do look behind you now and then.",
]
under_attack = [
    me.soldiers < 10 ? [
        "Guests, and nobody home to receive them? Everyone to the gates - now!",
        "Where are my soldiers when I need them? Servants, cooks, anyone - take up a spear!",
    ],
    lord and chance(50%) ? "My lord {lord} will be so displeased to hear of this.",
] ?? [
    "How rude, to turn up unannounced!",
    "Guards! Throw these people out!",
]
building_lost = [
    "Annoying.",
    "That was my favourite building.",
]
epoch_up = [
    epoch >= epoch.industrial and chance(50%) ? "{epoch}. Smoke and steel - so vulgar, so effective.",
    me.rank == 1 and chance(50%) ? "{epoch}. First in strength, first in fashion.",
] ?? [
    "{epoch}. New toys.",
    "A new age - how exciting.",
]
enemy_ahead = "{them} is in a hurry? Those who run fast stumble easily."
winning = [
    them.betrayals(me) > 0 and chance(60%) ? "You betrayed me, {them}. Did you think I would let that go? How sweet.",
    their_dead and chance(50%) ? "{me.kills(them)} of yours, {them}, and I have hardly creased my gown.",
] ?? [
    "{them}, you should start begging for mercy.",
    "Everything is going to plan.",
]
losing = [
    enemies > 1 and chance(50%) ? "Everyone against me at once? I suppose I should be flattered.",
    my_dead and them.kills(me) > me.kills(them) and chance(50%) ? "{them.kills(me)} of my people, {them}. I shall remember every one of them - and so will you.",
] ?? [
    "Hm. That was not the plan.",
    "Perhaps we should talk, {them}?",
]
desperate = [
    lord and chance(70%) ? "My lord {lord}! Your humble servant needs you - now!",
    allies > 0 and chance(60%) ? "Friends, now would be a lovely moment to remember everything I did for you!",
] ?? [
    "I am not giving up - I am merely changing tactics!",
    "This is not over yet!",
]
enemy_defeated = [
    them.betrayals(me) > 0 ? [
        "Poor {them}. Traitors so rarely age well.",
        "{them} broke faith with me, and now {them} is broken. I do like it when things come full circle.",
    ],
    them.refusals(me) > 0 and chance(50%) ? "{them} said no to me once. Look where it got them.",
    their_dead and chance(60%) ? "And {them} is history. I may have helped. A little.",
] ?? [
    "Poor {them}.",
    "And just like that, {them} is history.",
]
ally_defeated = "{them} is gone. Oh well, one finds new friends."
defeated = [
    "That ... was not ... the plan.",
    "Very well. A game is a game.",
]
surrender = [
    "I know when a game is lost. Well played, {them}.",
    "Time for a graceful exit.",
]
capitulate = "Darling {them}, why fight when we could be friends? {tribute} say we are."
capitulate_accepted = "{tribute} - a small price for such good company."
capitulate_refused = "Pity. I would have made such a charming ally."
all_submitted = "Well, {them}, it seems we all work for you now. Take your bow."
other_victory = lord == them ? [
    "Well played, {them}. Truly.",
    "I do love a good ending. Bravo, {them}.",
] : [
    "How fortunate that we were friends, {them}. For both of us.",
    "A shared victory, {them}. I shall remember who stood by me.",
]
wonder_threat = "What a pretty wonder. It would be a shame if something happened to it."
help_none = "Help? Me? Whatever gave you that idea?"

[lines:de]
greeting = [
    players == 2 and chance(50%) ? "Nur wir beide? Wie vertraulich.",
    players > 5 and chance(50%) ? "So viele Gäste. Hoffentlich reichen die Stühle ... eine Weile.",
    allied and chance(50%) ? "Schon verbündet, {them}? Wie süß. Mal sehen, wie lange das hält.",
] ?? [
    "Wie reizend, dass wir uns kennenlernen.",
    "Ich bin sicher, wir werden ... gut miteinander auskommen.",
    "Freunde? Feinde? Ach, das ergibt sich.",
]
war_declared = [
    them.tribute(me, 20) > 0 ? [
        "Erst Geschenke, jetzt Krieg? Wie launisch du bist, {them}.",
        "Danke für die Geschenke, {them}. Daraus werden so hübsche Pfeile - auf dich gerichtet.",
    ],
    them.refusals(me) > 0 and chance(60%) ? "Erst schlägst du meine Hand aus, {them}, jetzt erhebst du die Faust. Du machst es mir so leicht, dich nicht zu mögen.",
    pawn and chance(60%) ? "Du, {them}? Mit so wenig? Wie mutig. Wie überaus töricht.",
    rival and chance(60%) ? "Krieg, {them}? Dann muss ich eben klüger sein, als du stark bist. Das dürfte nicht schwer sein.",
] ?? [
    "Wie ungeschickt von dir, {them}.",
    "Krieg, {them}? Ich hatte gehofft, du wärst klüger.",
    "Oh, {them}. Das hättest du nicht tun sollen.",
]
betrayed = me.betrayals(them) > 0 ? [
    "Du zahlst es mir heim, {them}? Das habe ich dir wohl beigebracht. Wie schmeichelhaft.",
    "Ein Messer für ein Messer, {them}? Wie gerecht von dir. Ich wusste gar nicht, dass du Buch führst.",
] : them.betrayals(me) > 1 ? [
    "Zweimal, {them}? Einmal ist eine Überraschung. Zweimal ist eine Gewohnheit - und Gewohnheiten kann man brechen. Wie so vieles andere.",
    "Schon wieder, {them}? Beim ersten Mal habe ich mir eine kleine Notiz gemacht. Jetzt muss ich wohl ein ganzes Buch anfangen.",
] : [
    "Ausgerechnet du, {them}? Ich bin fast beeindruckt.",
    "Verrat ist meine Kunst, {them}. Du bist nur ein Stümper.",
]
peace_accept = [
    them.betrayals(me) > 0 ? [
        "Frieden, {them}. Ich vergebe - ich vergesse nur nie.",
        "Frieden, {them}. Und diesmal halte ich den Rücken an der Wand, wenn du nichts dagegen hast.",
    ],
    them.kills(me, this_war) > many_dead and them.kills(me, this_war) > me.kills(them, this_war) and chance(60%) ? "Du hast deinen Standpunkt klargemacht, {them}. Recht nachdrücklich. Frieden.",
    them.tribute(me, 30) > 0 and chance(50%) ? "Deine Geschenke sind mir nicht entgangen, {them}. Zu großzügigen Menschen bin ich immer nett.",
] ?? [
    "Frieden, {them}? Aber gern. Vorerst.",
    "Wie du willst, {them}. Wir sind jetzt Freunde.",
]
peace_refuse = [
    them.betrayals(me) > 0 ? [
        "Frieden mit dir, {them}? Ich habe dir einmal vertraut. Einmal ist meine Grenze.",
        "Dein Wort, {them}? So eines habe ich schon. Es ist zerbrochen, als ich mich das erste Mal darauf gestützt habe.",
    ],
    them.refusals(me) > 0 and chance(70%) ? "Jetzt willst du Frieden? Ich habe dir meine Hand gereicht, {them}, und du hast sie weggeschlagen. So etwas merke ich mir.",
    them.ignored(me) > 0 and chance(60%) ? "Du hast mein Angebot verstauben lassen, {them}. Jetzt darf deines dasselbe tun.",
    them.opinion(me) < -50% and chance(50%) ? "Du kannst mich nicht ausstehen, {them}, und willst jetzt Frieden? Wie ... verdächtig.",
] ?? [
    "Warum sollte ich, {them}? Was habe ich davon?",
    "Später vielleicht, {them}. Jetzt passt es mir nicht.",
    "Überzeug mich, {them}. Vielleicht mit Gold?",
]
block_refuse = [
    enemy.betrayals(me) > 0 ? [
        "{enemy} an deinem Tisch, {them}? {enemy} hat mir einmal ein Messer in den Rücken gestoßen. Ich speise nicht mit Messern.",
        "Frag doch {enemy}, was aus dem letzten Bündnis mit mir geworden ist, {them}. Dann weißt du, warum ich ablehne.",
    ],
] ?? [
    "Ein Bündnis mit {enemy}? So dumm bin ich nicht, {them}.",
    "{enemy} an deinem Tisch, {them}? Dann speise ich woanders.",
]
block_refuse_own = [
    "Und {enemy} verärgern? Mein Verbündeter würde es mir nie verzeihen, {them}.",
    "{enemy} wäre sehr verstimmt, {them}. Ein andermal.",
]
vassal_grumble = [
    enemy.betrayals(me) > 0 ? [
        "Frieden mit {enemy}, der mich verraten hat? Wie Ihr befehlt, {them}. Ich werde lächeln. Sehr lieblich.",
        "{enemy} hat mir die Treue gebrochen, und nun soll ich {enemy} einen Freund nennen? Euer Wunsch, {them}. Der Frieden vergisst so schnell - ich nicht.",
    ],
] ?? "Frieden mit {enemy}? Wenn Ihr darauf besteht, {them}. Ich behalte sie im Auge."
ask_lord = [
    "Ach, wie gern, {them}. Aber {enemy} hält jetzt meine Leine.",
    "Frag {enemy}, {them}. Ich bin nur die bescheidene Dienerin.",
]
alliance_offer = [
    enemy.betrayals(them) > 0 ? [
        "{enemy} hat dich einmal verraten, {them}. Ich würde niemals ... nun ja. Wollen wir {enemy} gemeinsam Manieren beibringen?",
        "Schmerzt es noch, {them}, was {enemy} dir angetan hat? Rache ist so viel süßer, wenn man sie teilt.",
    ],
    enemy.strength > me.strength + them.strength and chance(60%) ? "{enemy} ist stärker als wir beide zusammen, {them}. Allein sind wir der Nachtisch. Zusammen vielleicht der Koch.",
    them.refusals(me) > 0 and chance(60%) ? "Ich weiß, {them}, du hast mich schon einmal abgewiesen. Aber {enemy} ändert die Lage, nicht wahr?",
    them.opinion(me) > 30% and chance(60%) ? "Du hast immer so gut von mir gedacht, {them}. Machen wir es offiziell - gegen {enemy}.",
] ?? [
    "{them}, Liebes, {enemy} wird uns beide verschlingen. Sollten wir nicht ... zusammenarbeiten?",
    "Ein Vorschlag, {them}: Wir zwei gegen {enemy}. Was meinst du?",
]
offer_accepted = [
    them.betrayals(me) > 0 ? [
        "Wieder Freunde, {them}. Ich halte dir einen Stuhl frei - mit einem Dolch darunter. Nur für alle Fälle.",
        "Wieder verbündet, {them}. Letztes Mal hast du es beendet. Diesmal, glaube ich, tue ich es.",
    ],
    them.refusals(me) > 0 and chance(60%) ? "Erst hast du Nein gesagt, {them}. Ich wusste, du kommst noch zur Vernunft.",
] ?? [
    enemy ? "Wunderbar, {them}. Das wird {enemy} gar nicht gefallen.",
    "Wie schön, wir verstehen uns.",
]
offer_withdrawn = them.ignored(me) > 1 ? [
    "Schon wieder übergangen, {them}? Ich führe eine kleine Liste, weißt du. Du stehst schon {them.ignored(me)}-mal darauf.",
    "{them.ignored(me)} Angebote, {them}, und keine einzige Antwort. Schweigen ist auch eine Antwort, weißt du. Ich habe sie gehört.",
] : [
    "Du hast zu lange gezögert, {them}. Wie schade.",
    "Dann eben nicht, {them}. Ich merke mir das.",
]
betray = [
    them.betrayals(me) > 0 ? [
        "Dieses Spiel hast du mir selbst beigebracht, {them}. Gefallen dir meine Fortschritte?",
        "Dachtest du, ich hätte es vergessen, {them}? Ich habe nur auf den richtigen Moment gewartet. Das ist er.",
    ],
    them.tribute(me, 30) > 0 and chance(50%) ? "Danke für all die Geschenke, {them}. Sie bezahlen jetzt den Krieg.",
    pawn and chance(60%) ? "Du bist mir so eine Last geworden, {them}. Eine Dame reist mit leichtem Gepäck.",
] ?? [
    "Es tut mir ja so leid, {them}. Nein, eigentlich nicht.",
    "Du warst nützlich, {them}. Jetzt bist du es nicht mehr.",
    "Hast du wirklich geglaubt, ich bin deine Freundin, {them}?",
]
tribute_thanks = [
    at_war ? [
        "Gold mitten im Krieg, {them}? Wie rührend. Es ändert nichts - na ja, fast nichts.",
        "Du bezahlst deine Feindin, {them}? Ich werde es mit Bedacht ausgeben. Vermutlich für Soldaten.",
    ],
    them.betrayals(me) > 0 and chance(60%) ? "Geschenke von einem Verräter, {them}? Schlechtes Gewissen steht dir.",
    them.tribute(me) > big_tribute and chance(60%) ? "Schon {them.tribute(me)} an Geschenken, {them}. Man könnte fast meinen, du hättest Angst vor mir.",
] ?? [
    "Für mich? Wie aufmerksam, {them}.",
    "Du weißt, wie man eine Dame behandelt, {them}.",
]
tribute_small = at_war ? [
    "Ein Almosen mitten im Krieg, {them}? Du schätzt dich aber billig.",
    "Das ist in deinen Augen der Preis für Frieden, {them}? Dann geht der Krieg weiter.",
] : [
    "Ist das alles, {them}?",
    "Wie ... bescheiden, {them}. Ich finde bestimmt eine kleine Schublade dafür.",
]
attack = [
    them.razed(me, 20) > 0 and chance(60%) ? "{them} hat einige meiner hübschen Sachen kaputt gemacht. Erwidern wir die Höflichkeit.",
    them.betrayals(me) > 0 and chance(60%) ? "{them} hat mir einmal die Treue gebrochen. Heute kommt die Rechnung.",
    them.refusals(me) > 1 and chance(50%) ? "{them} hat so oft Nein zu mir gesagt. Mal sehen, ob {them} auch dazu Nein sagen kann.",
] ?? [
    "Zeit für eine kleine Überraschung für {them}.",
    "Unsere Truppen sind unterwegs zu {them}. Ganz leise.",
]
attack_threat = [
    them.betrayals(me) > 0 and chance(60%) ? "Schläfst du gut, {them}? Verräter schlafen meistens schlecht.",
    them.refusals(me) > 0 and chance(50%) ? "Du hättest mein Angebot annehmen sollen, {them}. Erinnerst du dich? Ich schon.",
    their_dead and chance(50%) ? "Schon {me.kills(them)} deiner Leute, {them}. Ich könnte aufhören zu zählen - aber es macht mir solche Freude.",
] ?? [
    "Mal sehen, wie gut du schläfst, {them}.",
    "Eine kleine Überraschung ist zu dir unterwegs, {them}.",
    "{them}, schau ruhig ab und zu hinter dich.",
]
under_attack = [
    me.soldiers < 10 ? [
        "Gäste, und niemand da, um sie zu empfangen? Alle an die Tore - sofort!",
        "Wo sind meine Soldaten, wenn ich sie brauche? Diener, Köche, irgendwer - greift zu den Speeren!",
    ],
    lord and chance(50%) ? "Mein Herr {lord} wird so verstimmt sein, davon zu hören.",
] ?? [
    "Wie unhöflich, unangemeldet zu erscheinen!",
    "Wachen! Werft diese Leute hinaus!",
]
building_lost = [
    "Ärgerlich.",
    "Das war mein Lieblingsgebäude.",
]
epoch_up = [
    epoch >= epoch.industrial and chance(50%) ? "{epoch}. Rauch und Stahl - so vulgär, so wirkungsvoll.",
    me.rank == 1 and chance(50%) ? "{epoch}. Die Erste an Stärke, die Erste in der Mode.",
] ?? [
    "{epoch}. Neue Spielzeuge.",
    "Ein neues Zeitalter - wie aufregend.",
]
enemy_ahead = "{them} hat es eilig? Wer schnell rennt, stolpert leicht."
winning = [
    them.betrayals(me) > 0 and chance(60%) ? "Du hast mich verraten, {them}. Dachtest du, das lasse ich auf sich beruhen? Wie süß.",
    their_dead and chance(50%) ? "{me.kills(them)} der Deinen, {them}, und mein Kleid hat kaum eine Falte.",
] ?? [
    "{them}, du solltest langsam um Gnade bitten.",
    "Läuft alles nach Plan.",
]
losing = [
    enemies > 1 and chance(50%) ? "Alle auf einmal gegen mich? Ich sollte mich wohl geschmeichelt fühlen.",
    my_dead and them.kills(me) > me.kills(them) and chance(50%) ? "{them.kills(me)} meiner Leute, {them}. Ich werde mir jeden einzelnen merken - und du auch.",
] ?? [
    "Hm. Das war so nicht geplant.",
    "Vielleicht sollten wir reden, {them}?",
]
desperate = [
    lord and chance(70%) ? "Mein Herr {lord}! Eure ergebene Dienerin braucht Euch - jetzt!",
    allies > 0 and chance(60%) ? "Freunde, jetzt wäre ein reizender Moment, sich an alles zu erinnern, was ich für euch getan habe!",
] ?? [
    "Ich gebe nicht auf - ich ändere nur meine Taktik!",
    "Das ist noch nicht vorbei!",
]
enemy_defeated = [
    them.betrayals(me) > 0 ? [
        "Arme {them}. Oder armer? Egal. Verräter altern selten gut.",
        "{them} hat mir die Treue gebrochen, und nun ist {them} selbst gebrochen. Ich mag es, wenn sich ein Kreis schließt.",
    ],
    them.refusals(me) > 0 and chance(50%) ? "{them} hat einmal Nein zu mir gesagt. Und nun seht, wohin das geführt hat.",
    their_dead and chance(60%) ? "Und schon ist {them} Geschichte. Ich habe vielleicht ein wenig nachgeholfen.",
] ?? [
    "Arme {them}. Oder armer? Egal.",
    "Und schon ist {them} Geschichte.",
]
ally_defeated = "{them} ist weg. Nun ja, man findet neue Freunde."
defeated = [
    "Das ... war nicht ... vorgesehen.",
    "Nun gut. Gespielt ist gespielt.",
]
surrender = [
    "Ich weiß, wann ein Spiel verloren ist. Gut gespielt, {them}.",
    "Zeit für einen eleganten Abgang.",
]
capitulate = "Ach, {them}, warum kämpfen, wenn wir Freunde sein könnten? {tribute} sagen, dass wir es sind."
capitulate_accepted = "{tribute} - ein kleiner Preis für so gute Gesellschaft."
capitulate_refused = "Schade. Ich wäre eine so reizende Verbündete gewesen."
all_submitted = "Nun, {them}, es scheint, wir arbeiten jetzt alle für Euch. Verbeugt Euch ruhig."
other_victory = lord == them ? [
    "Gut gespielt, {them}. Wirklich.",
    "Ich liebe ein gutes Ende. Bravo, {them}.",
] : [
    "Wie glücklich, dass wir Freunde waren, {them}. Für uns beide.",
    "Ein gemeinsamer Sieg, {them}. Ich werde mir merken, wer zu mir stand.",
]
wonder_threat = "Was für ein hübsches Wunder. Wäre doch schade, wenn ihm etwas zustößt."
help_none = "Helfen? Ich? Wie kommst du darauf?"
