; _persona.eeai - a template for a new AI personality (eeaimod). Not a personality itself: files starting with "_"
; are skipped. Copy it to a new name in this folder (e.g. seefahrer.eeai), fill it in, and the AIs of the next game
; may get it (picked at random, a matching colour first).
;
; Each situation below gets a line: a string, or a list of them (one at random), with conditions if you like:
;   greeting = [allied ? "Welcome back, {name}.", opinion < -50 ? ["Go away.", "You again?"]] ?? "Greetings, {name}."
; A situation without a line stays silent - unless it must be said (war, peace, offers, capitulation, victory): then
; a more general situation speaks (noted below) or computer.eeai. [lines:de] (or :fr ...) replaces [lines] in a game
; of that language, situation by situation.
;
; key = value, a value is an expression: "a string" ({placeholders} and {expressions} in it), ["a list", "of
; strings"] (one at random), allied ? "a condition", a ?? b, numbers ... The format, the expressions and every
; value of the game (opinion, them.soldiers, epoch.middle, ...): README.md in this folder.

; shared [vars] of other files in this folder, after this one's own (this_war, many_dead, big_tribute):
include = "_eeaimod_shared.eeai"

[personality]
; the name in the game (the player name in the scores and the chat); name:de for a German game
name = ""
;name:de = ""
; favoured player colours on random maps, the first free one wins: blue, red, yellow, magenta, orange, green, cyan,
; darkred, darkgrey, purple, grey, silver, lightyellow, lime, lightblue, pink (or German names, or "0".."16")
;color = ["blue", "cyan"]
; traits 0-100 (50 when left out). aggression: betrays, refuses peace; loyalty: keeps its alliances;
; pride: how long it holds a grudge and refuses peace after a declaration of war (pride x 3 s), how long it fights
; on before it capitulates; greed: what a tribute is worth to it; forgiveness: how fast a grudge fades;
; caution: capitulates earlier, pays more; talk: how often it says the lines that are not always said
aggression = 50
loyalty = 50
pride = 50
greed = 50
forgiveness = 50
caution = 50
talk = 50
; for the AI voice: who this is, in a few words (the model plays it)
character = ""

[style]
; EXPERIMENTAL - only with ai_style=1 in aimod.ini (default off: every AI plays the same, tested way). The same
; keys as in aimod.ini; they replace the difficulty's values for this AI. Uncomment what it should change.
;military_start_share = 
;military_income_share = 
;military_income_share_farms = 
;epoch_min = 
;epoch_max = 
;first_attack_min = 
;first_attack_max = 
;attack_interval_min = 
;attack_interval_max = 
;attack_group_percent = 
;attack_on_contact = 
;attack_for_resources = 
;attack_revenge = 
;citizen_share = 
;home_guard_share = 

[vars]
; named strings and expressions for its lines, before those of _system.eeai; [vars:de] (or :fr ...) replaces them in
; a game of that language. For example:
;address = opinion > 30 ? "my friend" : opinion < -30 ? "you dog" : "neighbour"

[lines]
; [] or a list with nothing left: no line (a more general situation or computer.eeai speaks, or nobody)
; the game begins - a first word to everyone - heard by everyone (60% of the time at talk=50)
greeting = []
; {name} has just declared war on you - heard by {name} only (at most every 20 s)
war_declared = []
; {name}, your ally until now, has betrayed you and declared war - heard by {name} only (at most every 20 s, without a line: war_declared)
betrayed = []
; you accept {name}'s offer of peace (you are allied now) - heard by {name} only
peace_accept = []
; you refuse {name}'s offer of peace - heard by {name} only (at most every 60 s)
peace_refuse = []
; you offer {name} an alliance against {enemy}, your common enemy - heard by {name} only
alliance_offer = []
; {name} has accepted your alliance offer - heard by {name} only
offer_accepted = []
; your alliance offer to {name} has expired unanswered - heard by {name} only
offer_withdrawn = []
; you betray {name}, your ally, and declare war on them - heard by {name} only
betray = []
; {name} sent you a generous tribute - heard by {name} only (at most every 20 s)
tribute_thanks = []
; {name} sent you a tribute - a small one - heard by {name} only (at most every 60 s)
tribute_small = []
; your army sets out to attack {name} - heard by its allies (40% of the time at talk=50, at most every 300 s)
attack = []
; your town is under attack - heard by its allies (60% of the time at talk=50, at most every 240 s)
under_attack = []
; you lost a building - heard by its allies (25% of the time at talk=50, at most every 180 s)
building_lost = []
; you have just reached the {epoch} age - heard by everyone (50% of the time at talk=50, at most every 60 s)
epoch_up = []
; an enemy is a whole age ahead of you - heard by its allies (40% of the time at talk=50, at most every 600 s)
enemy_ahead = []
; you are winning against {name} - heard by {name} only (40% of the time at talk=50, at most every 600 s)
winning = []
; you are losing the war - heard by its allies (50% of the time at talk=50, at most every 600 s)
losing = []
; you are close to defeat - heard by its allies
desperate = []
; {name} has been defeated - heard by everyone (80% of the time at talk=50, at most every 30 s)
enemy_defeated = []
; your ally {name} has been defeated - heard by its allies (80% of the time at talk=50, at most every 30 s)
ally_defeated = []
; you have been defeated - heard by everyone
defeated = []
; a wonder is threatened - heard by everyone (at most every 60 s)
wonder_threat = []
; you send help for an ally's wonder - heard by its allies (at most every 60 s)
wonder_help = []
; you have no help to give for an ally's wonder - heard by its allies (at most every 60 s)
wonder_nohelp = []
; you send land troops to help an ally - heard by its allies (at most every 30 s)
help_land = []
; you send aircraft to help an ally - heard by its allies (at most every 30 s)
help_air = []
; you send ships to help an ally - heard by its allies (at most every 30 s)
help_naval = []
; you have no troops to send an ally who asked for help - heard by its allies (at most every 30 s)
help_none = []
; you give up the game - heard by everyone (without a line: defeated)
surrender = []
; you capitulate: {name} is beating you, and you offer to PAY them a tribute ({tribute}) for peace - you give, they receive - heard by {name} only
capitulate = []
; {name} accepted your capitulation: you PAY them the tribute ({tribute}) and serve them from now on - heard by {name} only
capitulate_accepted = []
; {name} did not accept your capitulation: the war goes on - heard by {name} only
capitulate_refused = []
; your army is about to attack {name} - heard by {name} only (60% of the time at talk=50, at most every 300 s)
attack_threat = []
; every other player has submitted to {name}, your lord - heard by {name} only
all_submitted = []
; {name} has won the game - heard by everyone
other_victory = []
; you refuse {name}'s peace offer because {enemy} in their alliance cannot be at peace with your side - heard by {name} only (at most every 60 s, without a line: peace_refuse)
block_refuse = []
; you refuse {name}'s peace offer because your own ally {enemy} won't make peace with them - heard by {name} only (at most every 60 s, without a line: block_refuse)
block_refuse_own = []
; your lord {name} forces you to make peace with {enemy}, whom you hate - heard by {name} only (at most every 60 s)
vassal_grumble = []
; {name} offers you peace, but you are the vassal of {enemy} and have no diplomacy of your own - they must talk to {enemy} - heard by {name} only (at most every 60 s, without a line: peace_refuse)
ask_lord = []

; the same keys in German (or [lines:fr] ...): only those that should differ from [lines]
;[lines:de]
;greeting = ["..."]
