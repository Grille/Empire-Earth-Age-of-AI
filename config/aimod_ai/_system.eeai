veto_own = "{me} lehnt ab: der Verbündete {ally} will keinen Frieden mit {them}."
veto_block = "{me} lehnt ab: kein Frieden mit {them} und dessen Bündnis mit {ally}."
alliance_offer = "{me} bietet ein Bündnis gegen {enemy} an: stellen Sie {me} binnen {offer_minutes} Minuten auf Verbündet, um anzunehmen."
