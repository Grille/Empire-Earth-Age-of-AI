chat_who = "Keine Antwort: wen meinen Sie? Nennen Sie einen Namen ({names}) oder wählen Sie ihn im Chat-Filter."
chat_down = "Keine Antwort: das Sprachmodell ({url}) ist nicht erreichbar."
chat_busy = "Keine Antwort: das Sprachmodell hat zu viel zu tun - versuchen Sie es gleich noch einmal."
llm_down = "KI-Stimme: keine Antwort von {url} ({error}) - die Computerspieler sprechen ihre festen Zeilen."
llm_wait = "KI-Stimme: das Sprachmodell braucht lange - das Spiel ist pausiert, bis es antwortet (fortsetzen, um weiterzuspielen)."
llm_wait_down = "KI-Stimme: {url} ist nicht erreichbar - das Spiel ist pausiert, neuer Versuch alle 5 Sekunden (fortsetzen, um weiterzuspielen)."
talk_to = "an {them}: {text}"
food = "Nahrung"
wood = "Holz"
stone = "Stein"
gold = "Gold"
iron = "Eisen"
nothing = "nichts"
