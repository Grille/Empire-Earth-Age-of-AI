# Stress waves: one AI (P2) builds up for 60 minutes in peace (ai_ignore: it leaves the idle P1 alone), then P1
# gets ever stronger copies of P2's own army near P1's base (wave, % of P2's soldiers by type) and they charge
# P2's town (charge: every 10 s, see attack.c STRESS WAVES). The minute P2
# falls (game over) is the score; count 2 after each wave shows what is left.
# base e.g. "random_map=Continental,map_size=0,ai_count=1,seed=101", 120 min

wait_until(60min)
wave(1, 2, 50)
wait_until(60.05min)
charge(1, 2)
wait_until(60.2min)
count(2)
wait_until(65min)
wave(1, 2, 75)
wait_until(65.2min)
count(2)
wait_until(70min)
wave(1, 2, 100)
wait_until(70.2min)
count(2)
wait_until(75min)
wave(1, 2, 150)
wait_until(75.2min)
count(2)
wait_until(80min)
wave(1, 2, 200)
wait_until(80.2min)
count(2)
wait_until(85min)
wave(1, 2, 300)
wait_until(85.2min)
count(2)
wait_until(90min)
wave(1, 2, 400)
wait_until(90.2min)
count(2)
wait_until(95min)
wave(1, 2, 600)
wait_until(95.2min)
count(2)
wait_until(100min)
wave(1, 2, 800)
wait_until(100.2min)
count(2)
wait_until(105min)
wave(1, 2, 1000)
wait_until(105.2min)
count(2)
