{
  "name": "eeaimod-texts",
  "displayName": "eeaimod texts",
  "description": "Highlighting for the eeaimod text files (.eeai): personalities, _system.eeai, _template.eeai - sections, keys, strings, placeholders, expressions - and the setup scripts (scenarios/*.txt, *.setup): statements, functions, commands",
  "version": "0.9.0",
  "publisher": "eeaimod",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "eeai",
        "aliases": ["eeaimod texts"],
        "extensions": [".eeai", ".setup"],
        "filenamePatterns": ["**/_aimod/scenarios/*.txt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "eeai",
        "scopeName": "source.eeai",
        "path": "./syntaxes/eeai.tmLanguage.json"
      }
    ]
  }
}
