# llm.c test (with a mock or a real server): AI lines in the model's words, chat answers

llm()
wait_until(1min)
cmd("llm say 2 Hallo, wer bist du?")
wait_until(2min)
cmd("diplo chat Temur, was hältst du von Benedikt?")
wait_until(3min)
cmd("diplo chat Benedikt, verkaufst du mir Gold?")
wait_until(4min)
cmd("diplo chat Und was sagt der Rest?")
wait_until(5min)
diplo("capitulate", 3, 1)
wait_until(6min)
diplo("capitulate", 4, 1)
wait_until(7min)
llm()
