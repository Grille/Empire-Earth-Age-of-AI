# chat filter + name matching (P2 eroberer, P3 haendler, P4 ritter; the observer P1 is allied with all)

at(1min, () => {
    llm("filter", 3, 3)
    cmd("diplo chat was willst du eigentlich?")
})
at(2min, () => {
    llm("filter", 3, 2, 4)
    cmd("diplo chat kaufher, wie gehts?")
})
at(3min, () => {
    llm("filter", 0)
    cmd("diplo chat gunter, was meinst du?")
})
at(4min, () => {
    llm("filter", 2)
    diplo("chat", "hallo", "feinde")
})
at(5min, () => {
    llm("filter", 1)
    diplo("chat", "temurs", "reiter", "sind", "schwach")
})
at(6min, () => llm())
