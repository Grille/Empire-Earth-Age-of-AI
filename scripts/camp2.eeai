# hold the town, a camp that plays like the user's: P1 camps 15-18 tiles west of P2's Town Center (85,49) at minute 12,
# gets reinforcements every 2 minutes, pushes into the town every 4 (charge) and pulls back after a minute (move)

at(0.05min, () => {
    diplo(1, 2, 1)
    diplo(2, 1, 1)
})
at(11.5min, () => spawn(2, unit.inf10_machine_gun, 88, 49, 12))
at(12min, () => {
    spawn(1, unit.gun_artillery10_artillery, 64, 49, 8)
    spawn(1, unit.inf10_machine_gun, 68, 47, 16)
    spawn(1, unit.tank10_mk_v, 68, 53, 6)
})
at(14min, () => {
    spawn(1, unit.inf10_machine_gun, 66, 47, 4)
    spawn(1, unit.tank10_mk_v, 66, 53, 1)
    spawn(1, unit.gun_artillery10_artillery, 63, 49, 1)
})
at(15min, () => charge(1, 2))
at(16min, () => {
    spawn(1, unit.inf10_machine_gun, 66, 47, 4)
    spawn(1, unit.tank10_mk_v, 66, 53, 1)
    charge("off")
})
at(16.1min, () => move(1, 85, 49, 22, 67, 49))
