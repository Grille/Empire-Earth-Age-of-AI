# kills' filter: P1 (human) kills P3's army, citizens, a tower, a house, a helicopter, ships and fishing boats (water at 3-10,57-60)

wait_until(0.05min)
diplo(1, 3, 1)
wait_until(0.1min)
spawn(1, unit.aa10_stinger_soldier, 40, 40, 8)
spawn(1, unit.cav09_dragoon_gun, 40, 40, 12)
spawn(3, unit.inf01_clubman, 42, 42, 6)
spawn(3, unit.citizen, 42, 42, 6)
spawn(3, unit.b_guard_tower_bronze, 44, 40, 1)
spawn(3, unit.b_house, 44, 44, 1)
spawn(3, unit.a_helicopter_apache_longbow_12, 42, 42, 3)
spawn(1, unit.s08_imperial_battleship, 6, 60, 3)
spawn(3, unit.s02_fishing_boat_stone, 8, 58, 3)
spawn(3, unit.s03_copper_transport, 8, 58, 2)
wait_until(1min)
objs(1, unit.s08_imperial_battleship)
objs(3, unit.s02_fishing_boat_stone)
objs(3, unit.s03_copper_transport)
wait_until(3min)
diplo("kills")
cmd("texts eval 3 1 them.kills(me)")
cmd("texts eval 3 1 them.kills(me, units)")
cmd("texts eval 3 1 them.kills(me, army)")
cmd("texts eval 3 1 them.kills(me, airforce)")
cmd("texts eval 3 1 them.kills(me, marine)")
cmd("texts eval 3 1 them.kills(me, military)")
cmd("texts eval 3 1 them.kills(me, civilians)")
cmd("texts eval 3 1 them.kills(me, buildings)")
cmd("texts eval 3 1 them.kills(me, [units, buildings])")
cmd("texts eval 3 1 them.tribute(me, army)")
cmd("texts eval 3 1 them.kills(me, \"5\")")
llm("prompt", 3, 1)
cmd("texts eval 3 1 them.kills(me, 2, military)")
cmd("texts eval 3 1 them.kills(me, \"army\")")
# the kill log by type (any window, the filters of count)
cmd("texts eval 3 1 them.kills(me, kind.citizen)")
cmd("texts eval 3 1 them.kills(me, unit.citizen)")
cmd("texts eval 3 1 them.kills(me, [unit.inf01_clubman, kind.citizen])")
cmd("texts eval 3 1 them.kills(me, 2, unit.s02_fishing_boat_stone)")
cmd("texts eval 3 1 them.kills(me, 1000)")
cmd("texts eval 3 1 them.kills(me, 1)")
cmd("texts eval 3 1 them.kills(me, 3)")
cmd("texts eval 3 1 them.kills(me, 4, civilians)")
cmd("texts eval 3 1 them.kills(me, kind.towers)")
cmd("texts eval 3 1 them.kills(me, 5, 6)")
cmd("texts eval 3 1 them.tribute(me, kind.tank)")
cmd("texts eval 3 1 them.kills(me, kind.tank, 5)")
cmd("texts eval 3 1 \"\{them.kills(me, civilians)\} civilians, \{them.kills(me, buildings)\} buildings\"")
cmd("texts eval 3 1 them.razed(me)")
cmd("texts eval 3 1 them.kills(me, 5, \"army\")")
