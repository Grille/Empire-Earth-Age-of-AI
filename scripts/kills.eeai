# kills' filter: P1 (human) kills P3's army, citizens, a helicopter, ships and fishing boats (water at 3-10,57-60)

wait_until(0.05min)
diplo(1, 3, 1)
wait_until(0.1min)
spawn(1, unit.aa10_stinger_soldier, 40, 40, 8)
spawn(1, unit.cav09_dragoon_gun, 40, 40, 12)
spawn(3, unit.inf01_clubman, 42, 42, 6)
spawn(3, unit.citizen, 42, 42, 6)
spawn(3, unit.a_helicopter_apache_longbow_12, 42, 42, 3)
spawn(1, unit.s08_imperial_battleship, 6, 60, 3)
spawn(3, unit.s02_fishing_boat_stone, 8, 58, 3)
spawn(3, unit.s03_copper_transport, 8, 58, 2)
wait_until(1min)
objs(1, unit.s08_imperial_battleship)
objs(3, unit.s02_fishing_boat_stone)
objs(3, unit.s03_copper_transport)
wait_until(3min)
diplo("kills")
cmd("texts eval 3 1 them.kills(me)")
cmd("texts eval 3 1 them.kills(me, units.army)")
cmd("texts eval 3 1 them.kills(me, units.airforce)")
cmd("texts eval 3 1 them.kills(me, units.marine)")
cmd("texts eval 3 1 them.kills(me, units.military)")
cmd("texts eval 3 1 them.kills(me, units.civilian)")
cmd("texts eval 3 1 them.razed(me, units.army)")
cmd("texts eval 3 1 them.tribute(me, units.army)")
cmd("texts eval 3 1 them.kills(me, \"5\")")
llm("prompt", 3, 1)
cmd("texts eval 3 1 them.kills(me, 2, units.military)")
cmd("texts eval 3 1 them.kills(me, \"army\")")
cmd("texts eval 3 1 them.kills(me, units.navy)")
cmd("texts eval 3 1 them.kills(me, 5, \"army\")")
cmd("texts eval 3 1 \"\{them.kills(me, units.civilian)\} civilians, \{units.marine\}\"")
