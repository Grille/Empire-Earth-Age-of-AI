# a big landing (reference save): P2 given 40 machine gunners at home, 3 transports and resources - the size, the gathering at sea, the waves

wait_until(75.8min)
give(2, 4000)
spawn(2, unit.inf10_trench_mortar, 36, 84, 40)
spawn(2, unit.s10_atomic_age_transport, 22, 53, 3)
wait_until(76.2min)
attacknow(2)
wait_until(76.3min)
landing(2, "now")
every(2min, 78min, 90min, (run) => landing(2))
wait_until(91.8min)
diplo("kills")
