# llm.c test (with a mock or a real server): AI lines in the model's words, chat answers

llm()
at(1min, () => cmd("llm say 2 Hallo, wer bist du?"))
at(2min, () => cmd("diplo chat Temur, was hältst du von Benedikt?"))
at(3min, () => cmd("diplo chat Benedikt, verkaufst du mir Gold?"))
at(4min, () => cmd("diplo chat Und was sagt der Rest?"))
at(5min, () => diplo("capitulate", 3, 1))
at(6min, () => diplo("capitulate", 4, 1))
at(7min, () => llm())
