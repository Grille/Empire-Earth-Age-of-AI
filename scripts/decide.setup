# llm decide=1 test (mock server: scripts/mockllm.py decides by keyword - peace / war / gold): P1 (human) and P2
# (haendler, pride 30 = 90 s without peace after a declaration)

llm()
at(1min, () => diplo(1, 2, 1))
# within its pride's 90 s: no make_peace offered (only send_tribute)
at(2min, () => cmd("llm say 2 Frieden?"))
# now peace is possible, he is hostile: its offer (2 minutes, he doesn't take it: withdrawn at ~5)
at(3min, () => cmd("llm say 2 Frieden, Haendler?"))
# his peace offer: the model accepts (make_peace) - allies
at(6min, () => diplo(1, 2, 0))
at(7min, () => diplo())
# allied: a tribute (capped at a quarter), then the 3-minute wait and war before 5 minutes allied: not offered
at(8min, () => llm("say", 2, "Gib", "mir", "Gold"))
at(9min, () => llm("say", 2, "Gib", "mir", "mehr", "Gold"))
at(10min, () => cmd("llm say 2 Krieg!"))
# 5+ minutes allied: war; then (he is still allied) peace at once
at(12min, () => cmd("llm say 2 Krieg gegen dich!"))
at(13min, () => {
    diplo()
    llm("say", 2, "Frieden", "bitte")
})
at(14min, () => {
    diplo()
    llm()
})
